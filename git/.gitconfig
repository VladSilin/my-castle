# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
name = Vlad Silin
email = vlad.silin.y@gmail.com
[core]
	editor = nvim
# Machine-local overrides (credential helper, work identity, proxies).
# Git silently skips this include if the file doesn't exist.
[include]
	path = ~/.gitconfig-local
