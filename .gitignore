# Runtime state that lands inside this repo because stow symlinks whole
# directories: when ~/.vim and ~/.tmux don't already exist as real dirs, stow
# points them straight at vim/.vim and tmux/.tmux here, so anything a tool
# writes under them is written into the repo.

# vim-plug clones plugins into ~/.vim/plugged
vim/.vim/plugged/

# tmux plugins cloned at runtime (tmux-resurrect, per .tmux.conf)
tmux/.tmux/plugins/

# netrw history
vim/.vim/.netrwhist

# Editor scratch. `*~` also covers vim undo files (.name.un~) in the event
# undodir is ever pointed at '.'; .vimrc keeps them in ~/tmp/undodir instead.
*.swp
*.swo
*~

# macOS
.DS_Store

# ~/.claude is symlinked as a whole directory (claude/.claude/), so Claude
# Code's runtime state writes land inside this repo. Ignore everything it
# generates at runtime; keep only the files the `claude` package manages
# (settings.json, statusline.sh) and any files you author by hand (CLAUDE.md).
/claude/.claude/.last-cleanup
/claude/.claude/.last-update-result.json
/claude/.claude/backups/
/claude/.claude/cache/
/claude/.claude/file-history/
/claude/.claude/history.jsonl
/claude/.claude/ide/
/claude/.claude/image-cache/
/claude/.claude/mcp-needs-auth-cache.json
/claude/.claude/monthly_cost_cache
/claude/.claude/paste-cache/
/claude/.claude/plans/
/claude/.claude/plugins/
/claude/.claude/projects/
/claude/.claude/session-env/
/claude/.claude/sessions/
/claude/.claude/shell-snapshots/
/claude/.claude/skills/
/claude/.claude/tasks/
